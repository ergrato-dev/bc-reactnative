{
  "expo": {
    "name": "ProyectoSemana12",
    "slug": "proyecto-semana-12",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bootcamp.proyecto12"
    },
    "android": {
      "package": "com.bootcamp.proyecto12",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#61DAFB",
          "sounds": []
        }
      ]
    ]
  }
}
