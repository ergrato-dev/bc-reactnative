{
  "expo": {
    "name": "Ejercicio01-LocalNotifications",
    "slug": "ejercicio-01-local-notifications",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#61DAFB"
        }
      ]
    ]
  }
}
