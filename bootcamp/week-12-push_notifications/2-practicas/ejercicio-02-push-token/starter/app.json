{
  "expo": {
    "name": "Ejercicio02-PushToken",
    "slug": "ejercicio-02-push-token",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "eas": {
        "projectId": "demo-project-id"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bootcamp.ejercicio02"
    },
    "android": {
      "package": "com.bootcamp.ejercicio02",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#61DAFB"
        }
      ]
    ]
  }
}
